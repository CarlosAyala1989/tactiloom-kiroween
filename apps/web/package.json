{
  "name": "@ritualos/web",
  "version": "0.1.0",
  "private": true,
  "description": "RitualOS web app (Next.js): Board Studio, Workflow Studio, Review & Run, history and HTTP API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3210}",
    "build": "next build",
    "start": "next start --port ${WEB_PORT:-3210}",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "@ritualos/board-kit": "workspace:*",
    "@ritualos/compiler": "workspace:*",
    "@ritualos/contracts": "workspace:*",
    "@ritualos/db": "workspace:*",
    "@xyflow/react": "12.12.1",
    "fflate": "0.8.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
