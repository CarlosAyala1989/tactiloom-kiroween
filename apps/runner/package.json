{
  "name": "@tactiloom/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Tactiloom long-running worker: claims jobs from Postgres (FOR UPDATE SKIP LOCKED + lease) and runs the workflow engine",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tactiloom/compiler": "workspace:*",
    "@tactiloom/contracts": "workspace:*",
    "@tactiloom/db": "workspace:*",
    "@tactiloom/workflow-engine": "workspace:*",
    "dotenv": "18.0.9",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
