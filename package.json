{
  "name": "tactiloom",
  "version": "0.1.0",
  "private": true,
  "description": "Tactiloom — Build workflows with your hands. Run them on your computer.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "pnpm --filter @tactiloom/web build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && pnpm vision:lint",
    "test": "pnpm -r test && pnpm vision:test",
    "test:ts": "pnpm -r test",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "contracts:schemas": "pnpm --filter @tactiloom/contracts schemas",
    "board:generate": "pnpm --filter @tactiloom/board-kit generate",
    "examples:generate": "pnpm --filter @tactiloom/board-kit examples && cd services/vision && .venv/bin/python -m tactiloom_vision.fixtures",
    "benchmark:vision": "cd services/vision && .venv/bin/python -m tactiloom_vision.benchmark --scenes 120 --seed 7 --out ../../docs/benchmark-results/synthetic-latest.json",
    "vision:setup": "python3 -m venv services/vision/.venv && services/vision/.venv/bin/pip install -r services/vision/requirements-dev.txt",
    "vision:dev": "cd services/vision && .venv/bin/uvicorn tactiloom_vision.app:app --host 127.0.0.1 --port ${VISION_PORT:-8210}",
    "vision:test": "cd services/vision && .venv/bin/pytest -q",
    "vision:lint": "cd services/vision && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "runner:dev": "pnpm --filter @tactiloom/runner dev",
    "web:dev": "pnpm --filter @tactiloom/web dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tactiloom/compiler": "workspace:*",
    "@tactiloom/runner": "workspace:*",
    "@tactiloom/workflow-engine": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tactiloom/contracts": "workspace:*",
    "@tactiloom/db": "workspace:*",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
