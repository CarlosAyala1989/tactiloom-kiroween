{
  "$id": "https://raw.githubusercontent.com/CarlosAyala1989/tactiloom-kiroween/main/packages/contracts/schemas/workflow-ir.v1.schema.json",
  "title": "Tactiloom Workflow IR (tactiloom-ir/1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "irVersion": {
      "type": "string",
      "const": "tactiloom-ir/1"
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "const": "cards-v1"
    },
    "boardTemplateId": {
      "type": "string",
      "const": "board-v1"
    },
    "sourceMode": {
      "type": "string",
      "enum": [
        "physical",
        "image",
        "simulator"
      ]
    },
    "startNodeId": {
      "type": "string"
    },
    "nodes": {
      "minItems": 2,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+-[0-9]{2}$"
          },
          "markerId": {
            "type": "integer",
            "minimum": 10,
            "maximum": 89
          },
          "kind": {
            "type": "string",
            "enum": [
              "START",
              "INPUT_FILE",
              "EXTRACT_TEXT",
              "VALIDATE_FIELDS",
              "CONDITION",
              "CREATE_REPORT",
              "SAVE_REPORT",
              "REQUEST_REVIEW",
              "END"
            ]
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "col": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "N",
                  "E",
                  "S",
                  "W"
                ]
              }
            },
            "required": [
              "row",
              "col",
              "orientation"
            ],
            "additionalProperties": false
          },
          "dataRequirements": {
            "type": "object",
            "properties": {
              "requires": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "DocumentRef",
                    "ExtractedText",
                    "ValidationResult",
                    "Report",
                    "SavedArtifact",
                    "ReviewTask"
                  ]
                }
              },
              "produces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "DocumentRef",
                    "ExtractedText",
                    "ValidationResult",
                    "Report",
                    "SavedArtifact",
                    "ReviewTask"
                  ]
                }
              }
            },
            "required": [
              "requires",
              "produces"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "markerId",
          "kind",
          "params",
          "layout",
          "dataRequirements"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "port": {
            "type": "string",
            "enum": [
              "NEXT",
              "TRUE",
              "FALSE"
            ]
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "port",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "topologicalOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "irVersion",
    "compilerVersion",
    "catalogVersion",
    "boardTemplateId",
    "sourceMode",
    "startNodeId",
    "nodes",
    "edges",
    "topologicalOrder",
    "contentHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
