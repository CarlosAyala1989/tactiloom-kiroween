{
  "$id": "https://raw.githubusercontent.com/CarlosAyala1989/tactiloom-kiroween/main/packages/contracts/schemas/card-catalog.v1.schema.json",
  "title": "Tactiloom CardCatalog v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalogVersion": {
      "type": "string",
      "const": "cards-v1"
    },
    "dictionary": {
      "type": "string",
      "const": "DICT_4X4_100"
    },
    "reservedFiducialIds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "instanceIdRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "const": 10
        },
        "max": {
          "type": "number",
          "const": 89
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "cards": {
      "minItems": 1,
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "markerId": {
            "type": "integer",
            "minimum": 10,
            "maximum": 89
          },
          "kind": {
            "type": "string",
            "enum": [
              "START",
              "INPUT_FILE",
              "EXTRACT_TEXT",
              "VALIDATE_FIELDS",
              "CONDITION",
              "CREATE_REPORT",
              "SAVE_REPORT",
              "REQUEST_REVIEW",
              "END"
            ]
          },
          "cardInstanceId": {
            "type": "string",
            "pattern": "^[a-z]+-[0-9]{2}$"
          },
          "set": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "markerId",
          "kind",
          "cardInstanceId",
          "set",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "catalogVersion",
    "dictionary",
    "reservedFiducialIds",
    "instanceIdRange",
    "cards"
  ],
  "additionalProperties": false
}
