# Tactiloom environment variables. Copy to `.env` and change every secret.
# Never commit `.env`. All values below are local-development placeholders.

# --- PostgreSQL (docker compose service `db`) ---
POSTGRES_USER=tactiloom
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tactiloom
# Host port published on 127.0.0.1 only (55439 avoids clashing with other local Postgres instances).
POSTGRES_PORT=55439
DATABASE_URL=postgresql://tactiloom:change-me-local-only@127.0.0.1:55439/tactiloom
# Separate database used by `pnpm test:integration` (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://tactiloom:change-me-local-only@127.0.0.1:55439/tactiloom_test

# --- Web (Next.js) ---
WEB_PORT=3210
# Public origin used for Origin/CSRF checks and absolute URLs (https://… in production).
PUBLIC_ORIGIN=http://localhost:3210
# 32+ random bytes, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# --- Vision service (FastAPI + OpenCV, private network) ---
VISION_PORT=8210
VISION_URL=http://127.0.0.1:8210
# Shared secret between web and vision (header X-Internal-Token). `openssl rand -hex 24`.
VISION_INTERNAL_TOKEN=replace-with-openssl-rand-hex-24

# --- Sandbox shared by web (uploads) and runner (artifacts) ---
WORKSPACE_ROOT=./.data/workspace

# --- Demo session limits ---
DEMO_SESSION_TTL_HOURS=24
DEMO_MAX_ANALYSES_PER_HOUR=60
DEMO_MAX_RUNS_PER_HOUR=40
DEMO_MAX_UPLOADS=20
DEMO_MAX_UPLOAD_BYTES=10485760
DEMO_MAX_UPLOAD_TOTAL_BYTES=31457280
DEMO_MAX_CONCURRENT_RUNS=2
DEMO_MAX_SESSIONS_PER_IP_HOUR=30
# Global cap of simultaneously active demo workspaces (bounds disk usage of a public demo).
DEMO_MAX_ACTIVE_WORKSPACES=300
# Number of trusted reverse proxies in front of the web app (0 = exposed directly; use 1 behind Caddy/nginx).
TRUST_PROXY_HOPS=0

# --- Runner ---
RUNNER_POLL_INTERVAL_MS=500
RUNNER_LEASE_MS=30000
RUNNER_MAX_ATTEMPTS=3
RUNNER_MAX_DURATION_MS=60000
RUNNER_CLEANUP_INTERVAL_MS=300000
